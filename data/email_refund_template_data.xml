            <field name="body_html" type="html">
<div>
    <p>
        Dear <t t-out="object.partner_id.name or ''"/>
    </p>
    <p>
        A refund for your order <t t-out="object.reference or ''"/> has been initiated for the amount of <t t-out="object.amount or ''"/><t t-out="object.currency_id.symbol or ''"/>
    </p>
    <p>
        To receive the refund, please scan the QR code below with your Taler wallet
    </p>
    <div>align the qr code and set width height limits</div>
    <div>qr base64: <t t-out="object.taler_refund_qr"/></div>
    <div>
<!--        <img src="data:image/png;base64,<t t-out='object.refund_qr_code'/>" alt='Refund QR Code'/>-->
<!--        <img src="data:image/png;base64,object.taler_refund_qr" alt='Refund QR Code'/>-->
        <img t-att-src="'data:image/png;base64,%s' % object.taler_refund_qr" alt="Refund QR Code"/>
    </div>
    <p>
        If you cannot use the QR code, please use the following URI: <t t-out="object.taler_refund_uri or ''"/>
    </p>
    <p>
        If you have any questions, please contact us at <t t-out="object.company_id.email or ''"/>
    </p>
    <p>
        Thank you,<br/>
        <t t-out="object.company_id.name or ''"/>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
