<odoo>
    <record id="wb_student_list_view" model="ir.ui.view">
        <field name="name">wb.student.list.view</field>
        <field name="model">wb.student</field>
        <field name="arch" type="xml">
            <list string="Student">
                <field name="name" />
                <field name="name1" />
            </list>
        </field>
    </record>

    <record id="wb_student_form_view" model="ir.ui.view">
        <field name="name">wb.student.form.view</field>
        <field name="model">wb.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="name1"/>
                        <field name="name2"/>
                        <field name="name3"/>
                        <field name="name4"/>
                        <field name="taler_url"/>
                        <field name="secret_token"/>
                        <field name="test_order_id"/>
                        <button name="changeRecord" type="object" string="Change record"/>
                        <button name="requestGetToken" type="object" string="Request token"/>
                        <button name="requestGetOrderFromId" type="object" string="?"/>
                        <button name="requestGetOrderFromId" type="object" string="Get Order From Id"/>
                        <button name="requestGetConfig" type="object" string="Get Config"/>
                        <field name="order_summary"/>
                        <field name="order_fullfilment_message"/>
                        <field name="order_currency"/>
                        <field name="order_amount"/>
                        <button name="postPlaceOrder" type="object" string="Place Order"/>
                        <field name="order_latest_order_id"/>
                        <field name="order_last_order_url"/>
                        <button name="getOrderTalerUri" type="object" string="Get Order Taler Uri"/>
                        <field name="last_order_uri"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
                        <button name="requestGetConfig" type="object" string="?"/>
<!--                        <button name="change record" type="action" string="Change state" states="confirm"/>-->
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="wb_student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">wb.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="wb_student_root_menu"
              name="Student"
    />

    <menuitem id="wb_student_sub_root_menu"
              name="Weblearns"
              parent="wb_student_root_menu"
    />

    <menuitem id="wb_student_menu"
              action="wb_student_action"
              name="Student List"
              parent="wb_student_sub_root_menu"
    />
</odoo>
