<odoo>
    <record id="view_form_tops_welcome" model="ir.ui.view">
        <field name="name">tops.welcome.form</field>
        <field name="model">tops.welcome</field>
        <field name="arch" type="xml">
            <form string="Taler-Odoo Welcome Settings" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="test_summary"/>
                        <field name="test_fulfilment_message"/>
                        <field name="test_currency"/>
                        <field name="test_amount"/>
                        <field name="test_latest_order_id"/>
                        <field name="test_order_url"/>
                        <field name="test_order_uri"/>
                        <field name="test_merchant_refund_window"/>
                        <button name="requestGetToken" type="object" string="Request token"/>
                        <button name="requestGetConfig" type="object" string="Get Config"/>
                        <button name="postPlaceOrder" type="object" string="Place Order"/>
                        <button name="getOrderTalerUriTest" type="object" string="Get Order Taler Uri"/>
                        <button name="getSettingAndPrintIt" type="object" string="GetSettingAndPrintIt"/>
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
<!--                        <button name="requestGetConfig" type="object" string="?"/>-->
                        <!--                        <button name="change record" type="action" string="Change state" states="confirm"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tops_welcome_action" model="ir.actions.act_window">
        <field name="name">Open Taler-Odoo Welcome</field>
        <field name="res_model">tops.welcome</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_form_tops_welcome"/>
        <field name="res_id" ref="tops.tops_welcome_singleton"/>
        <field name="target">current</field>
    </record>

    <menuitem id="tops_root_menu"
              name="Taler-Odoo Payment System"
    />

    <menuitem id="menu_tops_welcome"
              name="Welcome"
              parent="tops_root_menu"
              action="tops_welcome_action"
              sequence="10"/>
</odoo>
