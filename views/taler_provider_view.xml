<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Taler Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'taler'">
                    <field name="taler_merchant_url" required="code == 'taler' and state != 'disabled'" groups="base.group_system"/>
                    <field name="taler_merchant_password" required="code == 'taler' and state != 'disabled'" password="True" groups="base.group_system"/>
                    <field name="fulfillment_message" required="code == 'taler' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
