<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <!-- Register the Taler payment provider -->
    <record id="payment_acquirer_taler" model="payment.acquirer">
      <field name="name">GNU Taler</field>
      <field name="provider">taler</field>
      <field name="company_id" eval="False"/> <!-- Makes it available for all companies -->
      <field name="state">disabled</field> <!-- You can enable it later in the UI -->
      <field name="view_template_id" ref="payment_taler.payment_taler_template"/>
      <field name="pre_msg">You will be redirected to the GNU Taler wallet.</field>
      <field name="post_msg">Thank you for your payment via GNU Taler!</field>
    </record>

  </data>
</odoo>
