#. module: tops
#: model_terms:ir.ui.view,arch_db:tops.taler_invoice_footer_logo
msgid ""
"<br/>\n"
"                            Use above order URI if you are having an issue with the QR Code."
msgstr ""
"<br/>\n"
"                            En cas de problème lors de l'utilisation du code QR, utilisez l'URI ci-dessus."

#. module: tops
#: model:mail.template,body_html:tops.email_refund
msgid ""
"<div style=\"font-family: 'Arial'; font-size: 14px;\">\n"
"    <p>\n"
"        Dear <t t-out=\"object.partner_id.name or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        A refund for your order <t t-out=\"object.reference or ''\"/> has been initiated for the amount of <t t-out=\"abs(object.amount) if object.amount else ''\"/><t t-out=\"object.currency_id.symbol or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        To receive the refund, please scan the QR code below with your Taler wallet\n"
"    </p>\n"
"    <div style=\"text-align: center;\">\n"
"        <img t-att-src=\"'data:image/png;base64,%s' % object.taler_refund_qr\" style=\"max-height:200px; max-width:200px\" alt=\"Refund QR Code\"/>\n"
"    </div>\n"
"    <p>\n"
"        If you cannot use the QR code, please use the following URI:<br/>\n"
"        <t t-out=\"object.taler_refund_uri or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        For any questions or requests, please contact us at <t t-out=\"object.company_id.email or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        Thank you,<br/>\n"
"        <t t-out=\"object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family: 'Arial'; font-size: 14px;\">\n"
"    <p>\n"
"        <t t-out=\"object.partner_id.name or ''\"/>,\n"
"    </p>\n"
"    <p>\n"
"        Une demande de remboursement pour la commande <t t-out=\"object.reference or ''\"/> d'un montant de <t t-out=\"abs(object.amount) if object.amount else ''\"/><t t-out=\"object.currency_id.symbol or ''\"/> a été émise.\n"
"    </p>\n"
"    <p>\n"
"        Pour confirmer le remboursement, veuillez scanner le code QR ci-dessous à l'aide de votre porte-monnaie Taler.\n"
"    </p>\n"
"    <div style=\"text-align: center;\">\n"
"        <img t-att-src=\"'data:image/png;base64,%s' % object.taler_refund_qr\" style=\"max-height:200px; max-width:200px\" alt=\"Refund QR Code\"/>\n"
"    </div>\n"
"    <p>\n"
"        En cas de problème lors de l'utilisation du code QR, utilisez l'URI ci-dessous:<br/>\n"
"        <t t-out=\"object.taler_refund_uri or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        Pour toute question, contactez-nous à <t t-out=\"object.company_id.email or ''\"/>\n"
"    </p>\n"
"    <p>\n"
"        Merci,<br/>\n"
"        <t t-out=\"object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

